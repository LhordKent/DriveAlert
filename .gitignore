# Never version server credentials. app/google-services.json remains allowed
# because it is Firebase Android client configuration, not an Admin key.
*firebase-adminsdk*.json
service-account*.json
application_default_credentials.json

# app/google-services.json is intentionally versioned so the school Firebase
# Authentication configuration works immediately after cloning.
