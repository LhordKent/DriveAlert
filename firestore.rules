rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(userId) { return signedIn() && request.auth.uid == userId; }

    function validProfile(data, userId) {
      return data.keys().hasOnly([
          'uid', 'firstName', 'middleName', 'lastName', 'email', 'phoneNumber',
          'userRole', 'accountStatus', 'registeredAt', 'deactivatedAt', 'connectionCode'
        ])
        && data.uid == userId
        && data.uid is string
        && (!('firstName' in data) || data.firstName is string)
        && (!('middleName' in data) || data.middleName is string)
        && (!('lastName' in data) || data.lastName is string)
        && (!('email' in data) || data.email is string)
        && (!('phoneNumber' in data) || data.phoneNumber is string)
        && (!('userRole' in data) || data.userRole in ['DRIVER', 'TRUSTED_CONTACT', 'BOTH'])
        && (!('accountStatus' in data) || data.accountStatus in ['ACTIVE', 'DEACTIVATED'])
        && (!('registeredAt' in data) || data.registeredAt is timestamp)
        && (!('deactivatedAt' in data) || data.deactivatedAt == null || data.deactivatedAt is timestamp)
        && (!('connectionCode' in data) || data.connectionCode.matches('^DA[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{26}$'));
    }

    function isConnectionParticipant(data) {
      return signedIn() && (request.auth.uid == data.driverUserId || request.auth.uid == data.trustedContactUserId);
    }
    function isConnectionRecipient(data) {
      return isConnectionParticipant(data) && request.auth.uid != data.requestedByUserId;
    }
    function isConnectionSender(data) {
      return isConnectionParticipant(data) && request.auth.uid == data.requestedByUserId;
    }
    function connectionIdIncludesCaller(connectionId) {
      return signedIn()
        && (connectionId.matches('^' + request.auth.uid + '__.+$')
          || connectionId.matches('^.+__' + request.auth.uid + '$'));
    }
    function connectionKeysValid(data) {
      return data.keys().hasAll([
          'connectionId', 'driverUserId', 'trustedContactUserId', 'driverName', 'driverEmail',
          'trustedContactName', 'trustedContactEmail', 'requestedByUserId', 'targetConnectionCode',
          'status', 'requestedAt', 'approvedAt', 'declinedAt', 'revokedAt'
        ])
        && data.keys().hasOnly([
          'connectionId', 'driverUserId', 'trustedContactUserId', 'driverName', 'driverEmail',
          'trustedContactName', 'trustedContactEmail', 'requestedByUserId', 'targetConnectionCode',
          'status', 'requestedAt', 'approvedAt', 'declinedAt', 'revokedAt'
        ])
        && data.connectionId is string && data.driverUserId is string && data.trustedContactUserId is string
        && data.driverName is string && data.driverEmail is string
        && data.trustedContactName is string && data.trustedContactEmail is string
        && data.requestedByUserId is string && data.targetConnectionCode is string
        && data.status in ['PENDING', 'APPROVED', 'DECLINED', 'REVOKED']
        && data.requestedAt is timestamp
        && (data.approvedAt == null || data.approvedAt is timestamp)
        && (data.declinedAt == null || data.declinedAt is timestamp)
        && (data.revokedAt == null || data.revokedAt is timestamp);
    }
    function connectionParticipantsUnchanged() {
      return request.resource.data.connectionId == resource.data.connectionId
        && request.resource.data.driverUserId == resource.data.driverUserId
        && request.resource.data.trustedContactUserId == resource.data.trustedContactUserId
        && request.resource.data.driverName == resource.data.driverName
        && request.resource.data.driverEmail == resource.data.driverEmail
        && request.resource.data.trustedContactName == resource.data.trustedContactName
        && request.resource.data.trustedContactEmail == resource.data.trustedContactEmail;
    }
    function validConnectionCreate(connectionId) {
      let data = request.resource.data;
      let targetCode = get(/databases/$(database)/documents/connectionCodes/$(data.targetConnectionCode));
      let expectedTarget = data.requestedByUserId == data.driverUserId
        ? data.trustedContactUserId
        : data.driverUserId;
      return connectionKeysValid(data)
        && data.connectionId == connectionId
        && connectionId == data.driverUserId + '__' + data.trustedContactUserId
        && data.driverUserId != data.trustedContactUserId
        && data.requestedByUserId == request.auth.uid
        && isConnectionParticipant(data)
        && data.status == 'PENDING' && data.requestedAt == request.time
        && data.approvedAt == null && data.declinedAt == null && data.revokedAt == null
        && data.targetConnectionCode.matches('^DA[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{26}$')
        && targetCode.data.active == true && targetCode.data.ownerUserId == expectedTarget;
    }
    function recipientApproves() {
      return resource.data.status == 'PENDING' && request.resource.data.status == 'APPROVED'
        && isConnectionRecipient(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt'])
        && request.resource.data.approvedAt == request.time;
    }
    function recipientDeclines() {
      return resource.data.status == 'PENDING' && request.resource.data.status == 'DECLINED'
        && isConnectionRecipient(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'declinedAt'])
        && request.resource.data.declinedAt == request.time;
    }
    function senderCancels() {
      return resource.data.status == 'PENDING' && request.resource.data.status == 'REVOKED'
        && isConnectionSender(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt'])
        && request.resource.data.revokedAt == request.time;
    }
    function participantRevokes() {
      return resource.data.status == 'APPROVED' && request.resource.data.status == 'REVOKED'
        && isConnectionParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt'])
        && request.resource.data.revokedAt == request.time;
    }
    function driverReRequests() {
      let targetCode = get(/databases/$(database)/documents/connectionCodes/$(request.resource.data.targetConnectionCode));
      return resource.data.status in ['DECLINED', 'REVOKED']
        && isConnectionParticipant(resource.data)
        && request.resource.data.status == 'PENDING'
        && request.resource.data.requestedByUserId == request.auth.uid
        && request.resource.data.requestedAt == request.time
        && request.resource.data.approvedAt == null
        && request.resource.data.declinedAt == null
        && request.resource.data.revokedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'requestedByUserId', 'targetConnectionCode', 'requestedAt', 'approvedAt', 'declinedAt', 'revokedAt'
        ])
        && targetCode.data.active == true
        && targetCode.data.ownerUserId == (request.auth.uid == resource.data.driverUserId
          ? resource.data.trustedContactUserId
          : resource.data.driverUserId);
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) && validProfile(request.resource.data, userId);
      allow update: if isSelf(userId)
        && validProfile(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && (!('registeredAt' in resource.data) || request.resource.data.registeredAt == resource.data.registeredAt)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['connectionCode'])
          || getAfter(/databases/$(database)/documents/connectionCodes/$(request.resource.data.connectionCode)).data.ownerUserId == userId);
      allow delete: if false;

      match /stageSyncRecords/{recordId} {
        function validStage3Create() {
          let data = request.resource.data;
          return data.keys().hasAll([
              'stageSyncRecordId', 'driverUserId', 'sessionId', 'recordType', 'periodStartedAt',
              'periodEndedAt', 'eventCount', 'signs', 'warningStage', 'warningStageAtDetection',
              'syncStatus', 'createdAtClient', 'uploadedAt'
            ])
            && data.keys().hasOnly([
              'stageSyncRecordId', 'driverUserId', 'sessionId', 'recordType', 'periodStartedAt',
              'periodEndedAt', 'eventCount', 'signs', 'warningStage', 'warningStageAtDetection',
              'syncStatus', 'createdAtClient', 'uploadedAt'
            ])
            && data.stageSyncRecordId == recordId && data.stageSyncRecordId is string
            && data.driverUserId == userId && data.driverUserId == request.auth.uid
            && data.sessionId is string
            // Accept legacy Android values so already-queued records from an
            // installed pre-contract-fix APK can drain after connectivity returns.
            && data.recordType in [
              'STAGE_3_TRANSITION', 'STAGE_3_PERSISTENCE',
              'STAGE3_TRANSITION', 'STAGE3_PERSISTENCE'
            ]
            && data.periodStartedAt is timestamp
            && (data.periodEndedAt == null || data.periodEndedAt is timestamp)
            && data.eventCount is int && data.eventCount >= 1
            && data.signs is list
            && data.warningStage == 'STAGE_3' && data.warningStageAtDetection == 3
            && data.syncStatus == 'SYNCED'
            && data.createdAtClient is timestamp && data.uploadedAt == request.time;
        }
        function approvedConnection() {
          let connectionId = resource.data.driverUserId + '__' + request.auth.uid;
          let connection = get(/databases/$(database)/documents/trustedContactConnections/$(connectionId));
          return connection.data.status == 'APPROVED' && connection.data.approvedAt <= resource.data.periodStartedAt;
        }
        allow create: if isSelf(userId) && validStage3Create();
        allow read: if isSelf(userId) || (signedIn() && resource.data.driverUserId == userId && approvedConnection());
        allow update, delete: if false;
      }

      match /trustedDriverStates/{driverId} {
        function validTrustedDriverState() {
          let data = request.resource.data;
          return data.keys().hasAll(['driverUserId', 'lastViewedAt', 'updatedAt'])
            && data.keys().hasOnly(['driverUserId', 'lastViewedAt', 'updatedAt'])
            && data.driverUserId == driverId
            && data.driverUserId is string
            && data.lastViewedAt == request.time
            && data.updatedAt == request.time;
        }
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId) && validTrustedDriverState();
        allow delete: if false;
      }
    }

    match /connectionCodes/{connectionCode} {
      function validCode(data) {
        return data.keys().hasAll(['ownerUserId', 'displayName', 'createdAt', 'active'])
          && data.keys().hasOnly(['ownerUserId', 'displayName', 'createdAt', 'active'])
          && data.ownerUserId is string && data.displayName is string
          && data.createdAt is timestamp && data.active is bool;
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validCode(request.resource.data)
        && connectionCode.matches('^DA[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{26}$')
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.active == true
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.connectionCode == connectionCode;
      allow update: if signedIn() && validCode(request.resource.data)
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /trustedContactConnections/{connectionId} {
      // A new-request transaction must read the deterministic document before it
      // exists. At that point resource.data is unavailable, so authorize only a
      // direct get whose path identifies the caller as one of the participants.
      allow get: if connectionIdIncludesCaller(connectionId) || isConnectionParticipant(resource.data);
      allow list: if isConnectionParticipant(resource.data);
      allow create: if validConnectionCreate(connectionId);
      allow update: if connectionKeysValid(request.resource.data) && connectionParticipantsUnchanged()
        && (recipientApproves() || recipientDeclines() || senderCancels() || participantRevokes() || driverReRequests());
      allow delete: if false;
    }
    // Device ownership is intentionally separate from Trusted Contact sharing.
    function canonicalDevice(id) { return id.matches('^[0-9A-F]{12}$'); }
    function ownsDevice(id) {
      return signedIn() && get(/databases/$(database)/documents/deviceOwnership/$(id)).data.ownerUserId == request.auth.uid;
    }
    function activeDeviceDriver(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid));
      return profile.data.accountStatus == 'ACTIVE' && profile.data.userRole in ['DRIVER', 'BOTH'];
    }
    match /devices/{deviceId} {
      allow get: if signedIn();
      allow list, update, delete: if false;
      allow create: if signedIn() && canonicalDevice(deviceId) && activeDeviceDriver(request.auth.uid)
        && request.resource.data.keys().hasAll(['deviceId', 'claimed', 'createdAt', 'schemaVersion'])
        && request.resource.data.keys().hasOnly(['deviceId', 'claimed', 'createdAt', 'schemaVersion'])
        && request.resource.data.deviceId == deviceId && request.resource.data.claimed == true
        && request.resource.data.createdAt == request.time && request.resource.data.schemaVersion == 1
        && getAfter(/databases/$(database)/documents/deviceOwnership/$(deviceId)).data.ownerUserId == request.auth.uid
        && getAfter(/databases/$(database)/documents/deviceOwnership/$(deviceId)).data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/deviceCredentials/$(deviceId + '__' + request.auth.uid)).data.kind == 'OWNER';
    }
    match /deviceOwnership/{deviceId} {
      allow get: if ownsDevice(deviceId) || (signedIn()
        && get(/databases/$(database)/documents/deviceDriverAccess/$(deviceId + '__' + request.auth.uid)).data.status in ['PENDING', 'ACTIVE']);
      allow list: if signedIn() && resource.data.ownerUserId == request.auth.uid;
      allow create: if signedIn() && canonicalDevice(deviceId) && activeDeviceDriver(request.auth.uid)
        && request.resource.data.keys().hasAll(['deviceId', 'ownerUserId', 'displayName', 'createdAt', 'schemaVersion'])
        && request.resource.data.keys().hasOnly(['deviceId', 'ownerUserId', 'displayName', 'createdAt', 'schemaVersion'])
        && request.resource.data.deviceId == deviceId && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
        && request.resource.data.schemaVersion == 1 && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/devices/$(deviceId))
        && getAfter(/databases/$(database)/documents/devices/$(deviceId)).data.claimed == true
        && getAfter(/databases/$(database)/documents/devices/$(deviceId)).data.createdAt == request.time;
      allow update, delete: if false;
    }
    function deviceAccessShape(d) {
      return d.keys().hasAll(['deviceId', 'ownerUserId', 'ownerDisplayName', 'driverUserId', 'driverDisplayName', 'deviceDisplayName',
          'status', 'revision', 'targetConnectionCode', 'requestedAt', 'acceptedAt', 'endedAt', 'billingMode', 'demoActivationId'])
        && d.keys().hasOnly(['deviceId', 'ownerUserId', 'ownerDisplayName', 'driverUserId', 'driverDisplayName', 'deviceDisplayName',
          'status', 'revision', 'targetConnectionCode', 'requestedAt', 'acceptedAt', 'endedAt', 'billingMode', 'demoActivationId'])
        && d.deviceId is string && canonicalDevice(d.deviceId) && d.ownerUserId is string && d.driverUserId is string
        && d.ownerUserId != d.driverUserId && d.ownerDisplayName is string && d.driverDisplayName is string && d.deviceDisplayName is string
        && d.status in ['PENDING', 'ACTIVE', 'DECLINED', 'CANCELLED', 'REMOVED', 'LEFT']
        && d.revision is int && d.revision > 0 && d.targetConnectionCode is string
        && d.requestedAt is timestamp && (d.acceptedAt == null || d.acceptedAt is timestamp)
        && (d.endedAt == null || d.endedAt is timestamp) && d.billingMode == 'SIMULATED'
        && d.demoActivationId is string && d.demoActivationId.matches('^[a-zA-Z0-9-]{1,80}$');
    }
    function validDeviceInvitation(d) {
      let code = get(/databases/$(database)/documents/connectionCodes/$(d.targetConnectionCode));
      let event = getAfter(/databases/$(database)/documents/users/$(d.ownerUserId)/deviceSubscriptionEvents/$(d.demoActivationId));
      let ownerProfile = get(/databases/$(database)/documents/users/$(d.ownerUserId));
      return ownsDevice(d.deviceId) && activeDeviceDriver(request.auth.uid) && d.ownerUserId == request.auth.uid
        && d.status == 'PENDING' && d.requestedAt == request.time && d.acceptedAt == null && d.endedAt == null
        && code.data.active == true && code.data.ownerUserId == d.driverUserId
        && d.driverDisplayName == code.data.displayName
        && d.ownerDisplayName == get(/databases/$(database)/documents/connectionCodes/$(ownerProfile.data.connectionCode)).data.displayName
        && d.deviceDisplayName == get(/databases/$(database)/documents/deviceOwnership/$(d.deviceId)).data.displayName
        && !exists(/databases/$(database)/documents/users/$(d.ownerUserId)/deviceSubscriptionEvents/$(d.demoActivationId))
        && event.data.createdAt == request.time && event.data.deviceId == d.deviceId && event.data.driverUserId == d.driverUserId
        && getAfter(/databases/$(database)/documents/deviceCredentials/$(d.deviceId + '__' + d.driverUserId)).data.serial == d.revision
        && getAfter(/databases/$(database)/documents/deviceCredentials/$(d.deviceId + '__' + d.driverUserId)).data.createdAt == request.time;
    }
    match /deviceDriverAccess/{accessId} {
      allow get: if signedIn() && (accessId.matches('^[0-9A-F]{12}__' + request.auth.uid + '$')
        || ownsDevice(accessId.split('__')[0]));
      allow list: if signedIn() && (resource.data.ownerUserId == request.auth.uid || resource.data.driverUserId == request.auth.uid);
      allow create: if deviceAccessShape(request.resource.data)
        && accessId == request.resource.data.deviceId + '__' + request.resource.data.driverUserId
        && request.resource.data.revision == 1 && validDeviceInvitation(request.resource.data);
      allow update: if deviceAccessShape(request.resource.data)
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.driverUserId == resource.data.driverUserId
        && request.resource.data.revision == resource.data.revision + 1
        && ((resource.data.status in ['DECLINED', 'CANCELLED', 'REMOVED', 'LEFT'] && validDeviceInvitation(request.resource.data))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revision', 'acceptedAt'])
            && signedIn() && request.auth.uid == resource.data.driverUserId && activeDeviceDriver(request.auth.uid)
            && resource.data.status == 'PENDING' && request.resource.data.status == 'ACTIVE'
            && request.resource.data.acceptedAt == request.time)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revision', 'endedAt'])
            && request.resource.data.endedAt == request.time && signedIn()
            && ((request.auth.uid == resource.data.driverUserId
                && ((resource.data.status == 'PENDING' && request.resource.data.status == 'DECLINED')
                  || (resource.data.status == 'ACTIVE' && request.resource.data.status == 'LEFT')))
              || (request.auth.uid == resource.data.ownerUserId && ownsDevice(resource.data.deviceId)
                && ((resource.data.status == 'PENDING' && request.resource.data.status == 'CANCELLED')
                  || (resource.data.status == 'ACTIVE' && request.resource.data.status == 'REMOVED'))))));
      allow delete: if false;
    }
    match /users/{ownerUid}/deviceSubscriptionEvents/{activationId} {
      allow get: if isSelf(ownerUid);
      allow list, update, delete: if false;
      allow create: if isSelf(ownerUid)
        && request.resource.data.keys().hasAll(['deviceId', 'ownerUserId', 'driverUserId', 'mode', 'kind', 'createdAt'])
        && request.resource.data.keys().hasOnly(['deviceId', 'ownerUserId', 'driverUserId', 'mode', 'kind', 'createdAt'])
        && request.resource.data.deviceId is string && canonicalDevice(request.resource.data.deviceId)
        && request.resource.data.ownerUserId == ownerUid && request.resource.data.driverUserId is string
        && request.resource.data.mode == 'SIMULATED' && request.resource.data.kind == 'ACTIVATION'
        && request.resource.data.createdAt == request.time && ownsDevice(request.resource.data.deviceId)
        && getAfter(/databases/$(database)/documents/deviceDriverAccess/$(request.resource.data.deviceId + '__' + request.resource.data.driverUserId)).data.demoActivationId == activationId
        && getAfter(/databases/$(database)/documents/deviceDriverAccess/$(request.resource.data.deviceId + '__' + request.resource.data.driverUserId)).data.requestedAt == request.time
        && getAfter(/databases/$(database)/documents/deviceDriverAccess/$(request.resource.data.deviceId + '__' + request.resource.data.driverUserId)).data.status == 'PENDING';
    }
    // Secrets/certificates are never stored in publicly readable claim records.
    match /deviceCredentials/{credentialId} {
      function credentialShape(d) {
        return d.keys().hasAll(['deviceId', 'ownerUserId', 'driverUserId', 'accountId', 'secret', 'kind', 'serial', 'certificate', 'createdAt'])
          && d.keys().hasOnly(['deviceId', 'ownerUserId', 'driverUserId', 'accountId', 'secret', 'kind', 'serial', 'certificate', 'createdAt'])
          && canonicalDevice(d.deviceId) && d.ownerUserId is string && d.driverUserId is string
          && credentialId == d.deviceId + '__' + d.driverUserId
          && d.accountId.matches('^[0-9A-F]{32}$') && d.secret.matches('^[0-9A-F]{64}$')
          && d.serial is int && d.serial >= 0 && d.serial <= 2147483647 && d.createdAt == request.time;
      }
      function driverCertificate(d) {
        let member = getAfter(/databases/$(database)/documents/deviceDriverAccess/$(credentialId));
        return ownsDevice(d.deviceId) && d.ownerUserId == request.auth.uid && d.driverUserId != request.auth.uid
          && d.kind == 'DRIVER' && d.certificate.matches('^[0-9A-F]{64}$') && d.serial > 0
          && member.data.status == 'PENDING' && member.data.revision == d.serial && member.data.requestedAt == request.time;
      }
      allow get: if signedIn() && (ownsDevice(credentialId.split('__')[0])
        || (resource.data.driverUserId == request.auth.uid && resource.data.kind == 'DRIVER'
          && get(/databases/$(database)/documents/deviceDriverAccess/$(credentialId)).data.status == 'ACTIVE'));
      allow create: if signedIn() && credentialShape(request.resource.data)
        && (driverCertificate(request.resource.data)
          || (request.resource.data.kind == 'OWNER' && request.resource.data.serial == 0 && request.resource.data.certificate == ''
            && request.resource.data.ownerUserId == request.auth.uid && request.resource.data.driverUserId == request.auth.uid
            && !exists(/databases/$(database)/documents/devices/$(request.resource.data.deviceId))
            && getAfter(/databases/$(database)/documents/deviceOwnership/$(request.resource.data.deviceId)).data.ownerUserId == request.auth.uid));
      allow update: if signedIn() && credentialShape(request.resource.data) && driverCertificate(request.resource.data)
        && request.resource.data.deviceId == resource.data.deviceId && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.driverUserId == resource.data.driverUserId && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.serial > resource.data.serial;
      allow list, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
